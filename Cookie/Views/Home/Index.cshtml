@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var username = Context.Request.Cookies["login"];
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="utf-8" />
    <title>Головна</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow p-4 text-center" style="min-width: 300px;">
        <h2 class="mb-4">Вітаємо, @username!</h2>

        <form asp-controller="Home" asp-action="Logout" method="post" class="mb-3">
            <button type="submit" class="btn btn-danger w-100">Вийти</button>
        </form>

        <a asp-controller="Login" asp-action="Create" class="text-decoration-none">На сторінку авторизації</a>
    </div>
</body>
</html>